# Hybrid LLM (OpenAI-compatible) — OpenRouter (cloud) or LM Studio / Ollama (local)
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Local fallback: LM Studio (http://localhost:1234/v1) or Ollama (http://localhost:11434)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
OLLAMA_BASE_URL=http://localhost:11434

# Voice pipeline (STT → LLM → TTS). No cloud voice APIs.
# STT: none (frontend text) | faster-whisper
JAMES_STT_BACKEND=none
JAMES_STT_MODEL=distil-large-v3
# TTS auto chain: qwen (clone) → kokoro → piper → none
JAMES_TTS_BACKEND=auto
# Kokoro preset voice (used when no Qwen clone voice is configured)
JAMES_TTS_VOICE=af_heart
# Qwen3-TTS clone (custom voices, e.g. James). Resident worker, VRAM released on idle.
# JAMES_VOICE_FILE points at {"ref_audio": "path/to/voice.wav", "ref_text": "exact transcript", "language": "English"}
# Record ~10-30s clean speech + transcript; clone prompt caches to <ref_audio>.clone.pt
#JAMES_VOICE_FILE=./voices/james.json
#JAMES_TTS_VENV=C:/Users/Chad/PycharmProjects/LanguageLearner/.venv/Scripts/python.exe
#JAMES_TTS_BASE_MODEL=C:/Users/Chad/PycharmProjects/LanguageLearner/tts/models/Qwen3-TTS-12Hz-1.7B-Base
#JAMES_TTS_SOX_DIR=C:/Users/Chad/AppData/Local/Microsoft/WinGet/Packages/ChrisBagwell.SoX_Microsoft.Winget.Source_8wekyb3d8bbwe/sox-14.4.2
#JAMES_TTS_IDLE_TIMEOUT=300
# NOTE: ELEVENLABS_* keys are legacy, only for backend/autonovel/gen_audiobook.py (batch audiobook)

# Slack Integration
# App-level token for your Slack app
SLACK_APP_TOKEN=xapp-your-token-here
# Bot token for your Slack app
SLACK_BOT_TOKEN=xoxb-your-token-here
# Channel ID to send notifications and listen for messages
SLACK_CHANNEL_ID=your-channel-id-here

# Server Configuration
# The port the backend server runs on. Default is 8180.
SERVER_PORT=8180

# Mobile Access Token
# Required for phone/LAN access. Leave empty to disable mobile auth.
MOBILE_AUTH_TOKEN=your_secret_token_here
